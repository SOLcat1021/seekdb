# LIMIT cardinality with residual filters, grouping and long prepared MATCH queries.
SET NAMES utf8mb4;
--disable_warnings
DROP TABLE IF EXISTS count_limit_predicates;
--enable_warnings
CREATE TABLE count_limit_predicates(id INT PRIMARY KEY,category INT,body TEXT,FULLTEXT INDEX ft(body) WITH PARSER beng);
INSERT INTO count_limit_predicates VALUES(1,1,'database database audit'),(2,2,'audit'),(3,2,'database performance'),(4,1,'other'),(5,2,''),(6,1,NULL),(7,1,'performance audit audit'),(8,2,'audit');
SELECT COUNT(*) FROM (SELECT id FROM count_limit_predicates WHERE MATCH(body) AGAINST('database audit') AND id<3 LIMIT 1 OFFSET 0) q;
SELECT COUNT(*) FROM (SELECT id FROM count_limit_predicates WHERE MATCH(body) AGAINST('database audit') AND id<3 LIMIT 2 OFFSET 1) q;
SELECT COUNT(*) FROM (SELECT id FROM count_limit_predicates WHERE MATCH(body) AGAINST('database audit') AND id<3 LIMIT 20 OFFSET 0) q;
SELECT COUNT(*) FROM (SELECT id FROM count_limit_predicates WHERE MATCH(body) AGAINST('database audit') AND id<3 LIMIT 3 OFFSET 50) q;
SELECT COUNT(*) FROM (SELECT id FROM count_limit_predicates WHERE MATCH(body) AGAINST('database audit') AND id>2 LIMIT 1 OFFSET 0) q;
SELECT COUNT(*) FROM (SELECT id FROM count_limit_predicates WHERE MATCH(body) AGAINST('database audit') AND id>2 LIMIT 2 OFFSET 1) q;
SELECT COUNT(*) FROM (SELECT id FROM count_limit_predicates WHERE MATCH(body) AGAINST('database audit') AND id>2 LIMIT 20 OFFSET 0) q;
SELECT COUNT(*) FROM (SELECT id FROM count_limit_predicates WHERE MATCH(body) AGAINST('database audit') AND id>2 LIMIT 3 OFFSET 50) q;
SELECT COUNT(*) FROM (SELECT id FROM count_limit_predicates WHERE MATCH(body) AGAINST('database audit') AND category=2 LIMIT 1 OFFSET 0) q;
SELECT COUNT(*) FROM (SELECT id FROM count_limit_predicates WHERE MATCH(body) AGAINST('database audit') AND category=2 LIMIT 2 OFFSET 1) q;
SELECT COUNT(*) FROM (SELECT id FROM count_limit_predicates WHERE MATCH(body) AGAINST('database audit') AND category=2 LIMIT 20 OFFSET 0) q;
SELECT COUNT(*) FROM (SELECT id FROM count_limit_predicates WHERE MATCH(body) AGAINST('database audit') AND category=2 LIMIT 3 OFFSET 50) q;
SELECT COUNT(*) FROM (SELECT id FROM count_limit_predicates WHERE MATCH(body) AGAINST('database audit') AND body LIKE '%audit%' LIMIT 1 OFFSET 0) q;
SELECT COUNT(*) FROM (SELECT id FROM count_limit_predicates WHERE MATCH(body) AGAINST('database audit') AND body LIKE '%audit%' LIMIT 2 OFFSET 1) q;
SELECT COUNT(*) FROM (SELECT id FROM count_limit_predicates WHERE MATCH(body) AGAINST('database audit') AND body LIKE '%audit%' LIMIT 20 OFFSET 0) q;
SELECT COUNT(*) FROM (SELECT id FROM count_limit_predicates WHERE MATCH(body) AGAINST('database audit') AND body LIKE '%audit%' LIMIT 3 OFFSET 50) q;
SELECT COUNT(*) FROM (SELECT id FROM count_limit_predicates WHERE MATCH(body) AGAINST('database audit') AND id IN (1,7) LIMIT 1 OFFSET 0) q;
SELECT COUNT(*) FROM (SELECT id FROM count_limit_predicates WHERE MATCH(body) AGAINST('database audit') AND id IN (1,7) LIMIT 2 OFFSET 1) q;
SELECT COUNT(*) FROM (SELECT id FROM count_limit_predicates WHERE MATCH(body) AGAINST('database audit') AND id IN (1,7) LIMIT 20 OFFSET 0) q;
SELECT COUNT(*) FROM (SELECT id FROM count_limit_predicates WHERE MATCH(body) AGAINST('database audit') AND id IN (1,7) LIMIT 3 OFFSET 50) q;
SELECT body FROM (SELECT DISTINCT body FROM count_limit_predicates WHERE MATCH(body) AGAINST('database audit') LIMIT 20) q ORDER BY body;
SELECT body,c FROM (SELECT body,COUNT(*) c FROM count_limit_predicates WHERE MATCH(body) AGAINST('database audit') GROUP BY body LIMIT 20) q ORDER BY body;
SELECT COUNT(DISTINCT body) FROM count_limit_predicates WHERE MATCH(body) AGAINST('database audit') LIMIT 1;
