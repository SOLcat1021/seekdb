PREPARE union_query FROM 'SELECT COUNT(*) FROM small_unscored_union WHERE MATCH(body) AGAINST(?)';
SET @q='alpha bravo';
EXECUTE union_query USING @q;
SET @q='missingterm';
EXECUTE union_query USING @q;
SET @q='alpha bravo charlie delta echo foxtrot golf hotel india';
EXECUTE union_query USING @q;
SET @q='alpha alpha bravo';
EXECUTE union_query USING @q;
SET @q='';
EXECUTE union_query USING @q;
SET @q=NULL;
EXECUTE union_query USING @q;
SET @q='hotel india';
EXECUTE union_query USING @q;
DEALLOCATE PREPARE union_query;
connect (writer,127.0.0.1,root,,kernel_fts_regression,10000);
connection default;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION WITH CONSISTENT SNAPSHOT;
SELECT COUNT(*) FROM small_unscored_union WHERE MATCH(body) AGAINST('alpha bravo');
connection writer;
UPDATE small_unscored_union SET body='alpha bravo' WHERE id=301;
DELETE FROM small_unscored_union WHERE id BETWEEN 1 AND 30;
connection default;
SELECT COUNT(*) FROM small_unscored_union WHERE MATCH(body) AGAINST('alpha bravo');
COMMIT;
SELECT COUNT(*) FROM small_unscored_union WHERE MATCH(body) AGAINST('alpha bravo');
disconnect writer;
DROP TABLE small_unscored_union;
