SELECT COUNT(*) FROM small_unscored_union WHERE MATCH(body) AGAINST('alpha');
SELECT id FROM small_unscored_union WHERE MATCH(body) AGAINST('alpha') ORDER BY id;
SELECT COUNT(*) FROM (SELECT id FROM small_unscored_union WHERE MATCH(body) AGAINST('alpha') LIMIT 17 OFFSET 11) q;
SELECT id FROM small_unscored_union WHERE MATCH(body) AGAINST('alpha') AND id%3=0 ORDER BY id LIMIT 13;
SELECT id,ROUND(MATCH(body) AGAINST('alpha'),8) score FROM small_unscored_union WHERE MATCH(body) AGAINST('alpha') ORDER BY score DESC,id LIMIT 5;
