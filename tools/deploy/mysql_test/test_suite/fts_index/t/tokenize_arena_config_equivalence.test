# Canonical parser configuration and prepared-parameter equivalence.
SET NAMES utf8mb4;
SELECT TOKENIZE(NULL);
SELECT TOKENIZE('OceanBase 数据库');
SELECT TOKENIZE(NULL,'space');
SELECT TOKENIZE(NULL,'space','[]');
SELECT TOKENIZE(NULL,'space','[{"output":"DEFAULT"}]');
SELECT TOKENIZE(NULL,'space','[{"output":"ALL"}]');
SELECT TOKENIZE('','space');
SELECT TOKENIZE('','space','[]');
SELECT TOKENIZE('','space','[{"output":"DEFAULT"}]');
SELECT TOKENIZE('','space','[{"output":"ALL"}]');
SELECT TOKENIZE('OceanBase DATABASE database aaa 123 中文数据库研究生命三公斤','space');
SELECT TOKENIZE('OceanBase DATABASE database aaa 123 中文数据库研究生命三公斤','space','[]');
SELECT TOKENIZE('OceanBase DATABASE database aaa 123 中文数据库研究生命三公斤','space','[{"output":"DEFAULT"}]');
SELECT TOKENIZE('OceanBase DATABASE database aaa 123 中文数据库研究生命三公斤','space','[{"output":"ALL"}]');
SELECT TOKENIZE(NULL,'beng');
SELECT TOKENIZE(NULL,'beng','[]');
SELECT TOKENIZE(NULL,'beng','[{"output":"DEFAULT"}]');
SELECT TOKENIZE(NULL,'beng','[{"output":"ALL"}]');
SELECT TOKENIZE('','beng');
SELECT TOKENIZE('','beng','[]');
SELECT TOKENIZE('','beng','[{"output":"DEFAULT"}]');
SELECT TOKENIZE('','beng','[{"output":"ALL"}]');
SELECT TOKENIZE('OceanBase DATABASE database aaa 123 中文数据库研究生命三公斤','beng');
SELECT TOKENIZE('OceanBase DATABASE database aaa 123 中文数据库研究生命三公斤','beng','[]');
SELECT TOKENIZE('OceanBase DATABASE database aaa 123 中文数据库研究生命三公斤','beng','[{"output":"DEFAULT"}]');
SELECT TOKENIZE('OceanBase DATABASE database aaa 123 中文数据库研究生命三公斤','beng','[{"output":"ALL"}]');
SELECT TOKENIZE(NULL,'ngram');
SELECT TOKENIZE(NULL,'ngram','[]');
SELECT TOKENIZE(NULL,'ngram','[{"output":"DEFAULT"}]');
SELECT TOKENIZE(NULL,'ngram','[{"output":"ALL"}]');
SELECT TOKENIZE('','ngram');
SELECT TOKENIZE('','ngram','[]');
SELECT TOKENIZE('','ngram','[{"output":"DEFAULT"}]');
SELECT TOKENIZE('','ngram','[{"output":"ALL"}]');
SELECT TOKENIZE('OceanBase DATABASE database aaa 123 中文数据库研究生命三公斤','ngram');
SELECT TOKENIZE('OceanBase DATABASE database aaa 123 中文数据库研究生命三公斤','ngram','[]');
SELECT TOKENIZE('OceanBase DATABASE database aaa 123 中文数据库研究生命三公斤','ngram','[{"output":"DEFAULT"}]');
SELECT TOKENIZE('OceanBase DATABASE database aaa 123 中文数据库研究生命三公斤','ngram','[{"output":"ALL"}]');
SELECT TOKENIZE(NULL,'ngram2');
SELECT TOKENIZE(NULL,'ngram2','[]');
SELECT TOKENIZE(NULL,'ngram2','[{"output":"DEFAULT"}]');
SELECT TOKENIZE(NULL,'ngram2','[{"output":"ALL"}]');
SELECT TOKENIZE('','ngram2');
SELECT TOKENIZE('','ngram2','[]');
SELECT TOKENIZE('','ngram2','[{"output":"DEFAULT"}]');
SELECT TOKENIZE('','ngram2','[{"output":"ALL"}]');
SELECT TOKENIZE('OceanBase DATABASE database aaa 123 中文数据库研究生命三公斤','ngram2');
SELECT TOKENIZE('OceanBase DATABASE database aaa 123 中文数据库研究生命三公斤','ngram2','[]');
SELECT TOKENIZE('OceanBase DATABASE database aaa 123 中文数据库研究生命三公斤','ngram2','[{"output":"DEFAULT"}]');
SELECT TOKENIZE('OceanBase DATABASE database aaa 123 中文数据库研究生命三公斤','ngram2','[{"output":"ALL"}]');
SELECT TOKENIZE('','ik');
SELECT TOKENIZE('','ik','[]');
SELECT TOKENIZE('','ik','[{"output":"DEFAULT"}]');
SELECT TOKENIZE('','ik','[{"output":"ALL"}]');
SELECT TOKENIZE('OceanBase DATABASE database aaa 123 中文数据库研究生命三公斤','ik');
SELECT TOKENIZE('OceanBase DATABASE database aaa 123 中文数据库研究生命三公斤','ik','[]');
SELECT TOKENIZE('OceanBase DATABASE database aaa 123 中文数据库研究生命三公斤','ik','[{"output":"DEFAULT"}]');
SELECT TOKENIZE('OceanBase DATABASE database aaa 123 中文数据库研究生命三公斤','ik','[{"output":"ALL"}]');
PREPARE cfg_stmt FROM 'SELECT TOKENIZE(?, ?, ?)';
SET @txt='Abc 数据库 test', @parser='beng', @cfg='[{"output":"DEFAULT"}]';
EXECUTE cfg_stmt USING @txt,@parser,@cfg;
SET @txt='Abc 数据库 test', @parser='beng', @cfg='[{"output":"ALL"}]';
EXECUTE cfg_stmt USING @txt,@parser,@cfg;
SET @txt='Abc 数据库 test', @parser='ik', @cfg='[{"output":"DEFAULT"}]';
EXECUTE cfg_stmt USING @txt,@parser,@cfg;
SET @txt='Abc 数据库 test', @parser='ik', @cfg='[{"output":"ALL"}]';
EXECUTE cfg_stmt USING @txt,@parser,@cfg;
SET @txt='Abc 数据库 test', @parser='ngram', @cfg='[{"output":"DEFAULT"}]';
EXECUTE cfg_stmt USING @txt,@parser,@cfg;
SET @txt='Abc 数据库 test', @parser='ngram', @cfg='[{"output":"ALL"}]';
EXECUTE cfg_stmt USING @txt,@parser,@cfg;
DEALLOCATE PREPARE cfg_stmt;
