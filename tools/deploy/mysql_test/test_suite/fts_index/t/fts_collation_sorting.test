# Byte-equal and distinct keys retain collation, NULL, padding and ordering semantics.
SET NAMES utf8mb4;
--disable_warnings
DROP TABLE IF EXISTS fts_collation_sorting;
--enable_warnings
CREATE TABLE fts_collation_sorting(id INT PRIMARY KEY,a VARCHAR(512) COLLATE utf8mb4_general_ci, b VARCHAR(512) COLLATE utf8mb4_general_ci);
