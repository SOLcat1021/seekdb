SELECT id,a=b,a<b,a>b,a<=>b,STRCMP(a,b) FROM fts_collation_sorting ORDER BY id;
SELECT id,a=CONCAT(a,''),HEX(a) FROM fts_collation_sorting ORDER BY id;
SELECT id,HEX(a) FROM fts_collation_sorting ORDER BY a,id;
SELECT id,HEX(a) FROM fts_collation_sorting ORDER BY a DESC,id;
SELECT x.id,y.id FROM fts_collation_sorting x JOIN fts_collation_sorting y ON x.a=y.b ORDER BY x.id,y.id;
SELECT SUM(CHAR_LENGTH(a)),SUM(CRC32(a)) FROM (SELECT a FROM fts_collation_sorting ORDER BY a,id LIMIT 15 OFFSET 3) q;
DROP TABLE fts_collation_sorting;
