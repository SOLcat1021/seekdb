# Independent membership oracle across 255/256/257 rows, long/empty/NULL documents, and index rebuild.
--disable_query_log
SET NAMES utf8mb4;
--disable_warnings
DROP TABLE IF EXISTS fts_streaming_boundaries; CREATE TABLE fts_streaming_boundaries(id VARCHAR(96) PRIMARY KEY, body TEXT, cn TEXT, payload VARCHAR(256));
