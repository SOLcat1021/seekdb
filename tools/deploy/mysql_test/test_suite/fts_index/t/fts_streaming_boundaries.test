ALTER TABLE fts_streaming_boundaries ADD FULLTEXT INDEX ft(body) WITH PARSER beng;
ALTER TABLE fts_streaming_boundaries ADD FULLTEXT INDEX cnft(cn) WITH PARSER ik;
--enable_warnings
SELECT id FROM fts_streaming_boundaries WHERE MATCH(body) AGAINST('sharedmarker') ORDER BY id;
SELECT COUNT(*) AS hits FROM (SELECT id FROM fts_streaming_boundaries WHERE MATCH(body) AGAINST('sharedmarker') LIMIT 0 OFFSET 0) t;
SELECT COUNT(*) AS hits FROM (SELECT id FROM fts_streaming_boundaries WHERE MATCH(body) AGAINST('sharedmarker') LIMIT 1 OFFSET 0) t;
SELECT COUNT(*) AS hits FROM (SELECT id FROM fts_streaming_boundaries WHERE MATCH(body) AGAINST('sharedmarker') LIMIT 255 OFFSET 1) t;
SELECT COUNT(*) AS hits FROM (SELECT id FROM fts_streaming_boundaries WHERE MATCH(body) AGAINST('sharedmarker') LIMIT 256 OFFSET 0) t;
