INSERT INTO r10_sort_keys VALUES (10000,NULL);
SELECT id,HEX(k) FROM r10_sort_keys ORDER BY k,id;
SELECT id,HEX(k) FROM r10_sort_keys ORDER BY k DESC,id;
SELECT MIN(id),COUNT(*) FROM r10_sort_keys GROUP BY k ORDER BY MIN(id);
SELECT COUNT(*) FROM r10_sort_keys a JOIN r10_sort_keys b ON a.k=b.k;
CREATE INDEX r10_sort_k ON r10_sort_keys(k);
SELECT id,HEX(k) FROM r10_sort_keys FORCE INDEX(r10_sort_k) ORDER BY k,id;
DROP TABLE r10_sort_keys;
