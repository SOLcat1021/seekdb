SET NAMES utf8mb4;
DROP TABLE IF EXISTS backfill_row_buffer_reuse;
CREATE TABLE backfill_row_buffer_reuse(id INT PRIMARY KEY,title TEXT,body TEXT);
ALTER TABLE backfill_row_buffer_reuse ADD FULLTEXT INDEX pool_en(title,body) WITH PARSER beng;
ALTER TABLE backfill_row_buffer_reuse ADD FULLTEXT INDEX pool_cn(body) WITH PARSER ik;
