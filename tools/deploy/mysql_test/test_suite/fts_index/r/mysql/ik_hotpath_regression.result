SET NAMES utf8mb4;
SELECT TOKENIZE(CONVERT(0x000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f USING utf8mb4),'ik') AS tokens;
tokens
["0123456789", "abcdefghijklmnopqrstuvwxyz"]
SELECT TOKENIZE('一二两三四五六七八九十零壹贰叁肆伍陆柒捌玖拾百千万亿佰仟萬億兆卅廿公斤','ik') AS tokens;
tokens
["公斤", "一二两三四五六七八九十零壹贰叁肆伍陆柒捌玖拾百千万亿佰仟萬億兆卅廿"]
SELECT TOKENIZE('三公斤12个两百万元一亿人十兆字节','ik') AS tokens;
tokens
["万元", "一亿人", "字节", "两百", "三公斤", "十兆", "12个"]
SELECT TOKENIZE('三公斤12个两百万元一亿人十兆字节','ik','[{"additional_args":[{"ik_mode":"max_word"}]}]') AS tokens;
tokens
["公斤", "个", "两", "万元", "三公", "两百万", "一亿", "12", "三", "一亿人", "百万元", "斤", "字节", "两百", "人", "十兆", "百万"]
SELECT TOKENIZE('a#b a&b a+b a-b a.b a@b a_b 12,34 12.34','ik') AS tokens;
tokens
["a&b", "12.34", "a-b", "a#b", "a_b", "a.b", "a+b", "12,34", "a@b"]
SELECT TOKENIZE('ＡＺａｚ０９ ＃＆＋－．＠＿，。 数据库😀𠀀','ik') AS tokens;
tokens
["ａｚａｚ０９", "数据库"]
SELECT TOKENIZE('A\0B\n12\t数据库','ik') AS tokens;
tokens
["a", "12", "数据库", "b"]
SELECT JSON_LENGTH(TOKENIZE(CONVERT( USING utf8mb4),'ik')) AS token_count;
token_count
9
SELECT JSON_LENGTH(TOKENIZE(CONVERT( USING utf8mb4),'ik','[{"additional_args":[{"ik_mode":"max_word"}]}]')) AS token_count;
token_count
10
SELECT TOKENIZE(NULL,'ik') AS tokens;
ERROR 0A000: ik with the binary charset is not supported
SELECT TOKENIZE('','ik') AS tokens;
tokens
[]
DROP TABLE IF EXISTS ik_hotpath_docs;
CREATE TABLE ik_hotpath_docs (
id INT PRIMARY KEY,
smart_body TEXT,
max_body TEXT,
FULLTEXT INDEX smart_idx(smart_body) WITH PARSER ik,
FULLTEXT INDEX max_idx(max_body) WITH PARSER ik PARSER_PROPERTIES=(ik_mode="max_word")
);
INSERT INTO ik_hotpath_docs VALUES
(1,'数据库三公斤 abc-123','数据库三公斤 abc-123'),
(2,'全文检索十兆字节 OceanBase','全文检索十兆字节 OceanBase'),
(3,'数据库数据库 A.Z 12.34','数据库数据库 A.Z 12.34'),
(4,NULL,NULL),(5,'','');
SELECT id FROM ik_hotpath_docs WHERE MATCH(smart_body) AGAINST('数据库') ORDER BY id;
id
1
3
SELECT id FROM ik_hotpath_docs WHERE MATCH(max_body) AGAINST('数据库') ORDER BY id;
id
1
3
SELECT id FROM ik_hotpath_docs WHERE MATCH(smart_body) AGAINST('OceanBase') ORDER BY id;
id
2
START TRANSACTION;
UPDATE ik_hotpath_docs SET smart_body='全文检索', max_body='全文检索' WHERE id=1;
DELETE FROM ik_hotpath_docs WHERE id=3;
SELECT id FROM ik_hotpath_docs WHERE MATCH(smart_body) AGAINST('数据库') ORDER BY id;
id
ROLLBACK;
SELECT id FROM ik_hotpath_docs WHERE MATCH(smart_body) AGAINST('数据库') ORDER BY id;
id
1
3
UPDATE ik_hotpath_docs SET smart_body='全文检索', max_body='全文检索' WHERE id=1;
DELETE FROM ik_hotpath_docs WHERE id=3;
SELECT id FROM ik_hotpath_docs WHERE MATCH(smart_body) AGAINST('数据库') ORDER BY id;
id
SELECT id FROM ik_hotpath_docs WHERE MATCH(max_body) AGAINST('全文检索') ORDER BY id;
id
1
2
DROP TABLE ik_hotpath_docs;
