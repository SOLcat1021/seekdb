SET NAMES utf8mb4;
DROP TABLE IF EXISTS binary_docid_membership;
CREATE TABLE binary_docid_membership(id VARBINARY(32) PRIMARY KEY,body TEXT COLLATE utf8mb4_general_ci,FULLTEXT INDEX ft(body) WITH PARSER beng);
INSERT INTO binary_docid_membership VALUES(X'','database audit'),(X'00','audit audit'),(X'20','database performance'),(X'2020','missing'),(X'00000000000000000000000000000000','DATABASE database audit'),(X'00000000000000000000000000000020','audit performance'),(X'01000000000000000000000000000001',NULL),(X'01000000000000000000000000000020',''),(X'010000000000000000000000000000ff','database performance audit'),(X'ffffffffffffffffffffffffffffffff','performance'),(X'0102030405060708090a0b0c0d0e0f101112','audit');
SELECT COUNT(*) FROM binary_docid_membership WHERE MATCH(body) AGAINST('database audit');
