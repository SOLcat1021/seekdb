UPDATE binary_docid_membership SET body='performance performance' WHERE id=X'20';
DELETE FROM binary_docid_membership WHERE id=X'00000000000000000000000000000020';
PREPARE binary_docid_query FROM 'SELECT COUNT(*) FROM binary_docid_membership WHERE MATCH(body) AGAINST(?)';
SET @q='database audit';
EXECUTE binary_docid_query USING @q;
